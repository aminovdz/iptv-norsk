---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import LiveScores from '../../components/LiveScores.astro';
import { getCollection } from 'astro:content';
import { BookOpen, Clock, Calendar, ArrowRight, Sparkles, User, ShieldCheck } from 'lucide-astro';

const breadcrumbs = [
  { name: 'Hjem', item: '/' },
  { name: 'Guider & Artikler', item: '/guides' },
];

// Fetch guides from content collections
const rawGuides = await getCollection('guides').catch(() => []);
const guides = rawGuides.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Fallback guides list if collection is empty initially
const sampleGuides = [
  {
    slug: 'beste-iptv-apper',
    data: {
      title: 'Beste IPTV Apper i 2026: TiviMate, IBO Player & Smart IPTV Testet',
      description: 'En komplett guide til de beste og mest stabile IPTV-appene for Smart TV (Samsung, LG), Amazon Firestick 4K og Apple TV.',
      pubDate: new Date('2026-02-15'),
      author: 'Norsk IPTV Redaksjon',
      readTime: '6 min lesing'
    }
  },
  {
    slug: 'smart-tv-oppsett',
    data: {
      title: 'Hvordan Sette Opp IPTV på Smart TV (Samsung, LG & Android TV)',
      description: 'Trinn-for-trinn installasjonsguide for å konfigurere M3U-spillelister og Xtream Codes på under 5 minutter.',
      pubDate: new Date('2026-02-10'),
      author: 'Teknisk Support Team',
      readTime: '5 min lesing'
    }
  },
  {
    slug: 'anti-buffer-guide',
    data: {
      title: 'Slik Unngår Du Bufring og Hakking på IPTV Under Direktesendt Sport',
      description: 'Lær hvordan du optimaliserer WiFi, DNS-innstillinger og bufferstørrelse for feilfri 4K strømming under fotballkamper.',
      pubDate: new Date('2026-02-05'),
      author: 'Nettverksekspert',
      readTime: '7 min lesing'
    }
  }
];

const displayGuides = guides.length > 0 ? guides : sampleGuides;
---

<Layout
  title="IPTV Guider & Kunnskapsbase 2026 | Norsk IPTV"
  description="Lær alt om oppsett av IPTV på Smart TV, de beste appene for 2026, feilsøking og optimalisering av 4K-strømming i Norge."
  breadcrumbs={breadcrumbs}
>
  <StickyHeader />

  <main class="py-16 md:py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-4">
        <BookOpen class="w-3.5 h-3.5 text-[#06b6d4]" />
        <span>Kunnskapsbase & Veiledninger</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
        Guider, Tester & <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">Brukertips</span>
      </h1>
      <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
        Finn nyttige veiledninger for oppsett på Smart TV, app-anbefalinger og eksperttips for å få maksimalt ut av ditt <strong>IPTV abonnement</strong>.
      </p>
    </div>

    <!-- LiveScores Infinite Loop Carousel -->
    <div class="mb-20 -mx-4 sm:-mx-6 lg:-mx-8">
      <LiveScores />
    </div>

    <!-- Guides Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 mb-20">
      {displayGuides.map((guide) => (
        <article class="group rounded-3xl bg-[#0e0e17] border border-white/10 hover:border-[#8b5cf6]/50 p-7 transition-all duration-300 transform hover:-translate-y-1 shadow-xl hover:shadow-[#8b5cf6]/10 flex flex-col justify-between">
          
          <div>
            <!-- Meta Bar -->
            <div class="flex items-center justify-between text-xs text-gray-400 mb-4 pb-3 border-b border-white/5">
              <div class="flex items-center gap-1.5">
                <Calendar class="w-3.5 h-3.5 text-[#8b5cf6]" />
                <span>{new Date(guide.data.pubDate).toLocaleDateString('nb-NO', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>
              <div class="flex items-center gap-1.5 text-[#06b6d4]">
                <Clock class="w-3.5 h-3.5" />
                <span>{guide.data.readTime || '5 min lesing'}</span>
              </div>
            </div>

            <!-- Title -->
            <h2 class="text-xl font-bold text-white group-hover:text-[#a78bfa] transition-colors leading-snug mb-3">
              <a href={`/guides/${guide.id || guide.slug}`}>
                {guide.data.title}
              </a>
            </h2>

            <!-- Excerpt -->
            <p class="text-xs sm:text-sm text-gray-400 leading-relaxed mb-6">
              {guide.data.description}
            </p>
          </div>

          <!-- Card Footer -->
          <div class="pt-4 border-t border-white/5 flex items-center justify-between">
            <div class="flex items-center gap-2 text-xs text-gray-400">
              <User class="w-3.5 h-3.5 text-gray-500" />
              <span>{guide.data.author || 'Norsk IPTV'}</span>
            </div>
            <a
              href={`/guides/${guide.id || guide.slug}`}
              class="inline-flex items-center gap-1 text-xs font-bold text-[#8b5cf6] group-hover:text-white transition-colors"
              aria-label={`Les guiden: ${guide.data.title}`}
            >
              <span>Les Guide</span>
              <ArrowRight class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" />
            </a>
          </div>

        </article>
      ))}
    </div>

    <!-- Permanent Promotional Callout Banner -->
    <div class="rounded-3xl bg-gradient-to-r from-[#181432] via-[#0f0e1d] to-[#08121f] border border-[#8b5cf6]/40 p-8 sm:p-12 shadow-2xl flex flex-col md:flex-row items-center justify-between gap-6">
      <div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#8b5cf6]/20 text-[#c084fc] text-xs font-bold mb-2">
          <Sparkles class="w-3.5 h-3.5" />
          <span>KLAR TIL Å TESTE?</span>
        </div>
        <h3 class="text-2xl font-extrabold text-white">Opplev Norges Raskeste IPTV Tjeneste</h3>
        <p class="text-xs sm:text-sm text-gray-300 mt-1 max-w-xl">
          Få 12 måneder med 4K Ultra HD strømming og 60 FPS sport for kun 600 kr. 24-timers refusjonsgaranti.
        </p>
      </div>

      <a
        href="/#pricing"
        class="inline-flex items-center gap-2 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4] text-white font-bold text-sm uppercase tracking-wider shadow-lg shadow-[#8b5cf6]/30 shrink-0 hover:scale-105 transition-transform"
      >
        <span>Se Priser & Planer</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </div>

  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
