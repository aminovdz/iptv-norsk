---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { AlertCircle, Shield, Info } from 'lucide-astro';

const breadcrumbs = [
  { name: 'Hjem', item: '/' },
  { name: 'Ansvarsfraskrivelse', item: '/disclaimer' },
];
---

<Layout
  title="Ansvarsfraskrivelse | Norsk IPTV"
  description="Juridisk ansvarsfraskrivelse for Norsk IPTV strømmetjenester og nettstedsinnhold."
  breadcrumbs={breadcrumbs}
>
  <StickyHeader />

  <main class="py-16 md:py-24 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-4">
        <Info class="w-3.5 h-3.5 text-[#06b6d4]" />
        <span>Juridisk Informasjon</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-4">
        Ansvarsfraskrivelse
      </h1>
      <p class="text-xs sm:text-sm text-gray-400">
        Viktig juridisk informasjon for besøkende og abonnenter
      </p>
    </div>

    <!-- Content Card -->
    <div class="rounded-3xl bg-[#0e0e17] border border-white/10 p-8 sm:p-12 shadow-xl space-y-8 text-gray-300 text-sm sm:text-base leading-relaxed">
      
      <section>
        <h2 class="text-xl font-bold text-white mb-3">1. Generell Informasjon</h2>
        <p>
          All informasjon som tilbys på dette nettstedet (<strong>norsk-iptv.net</strong>) er kun ment for generell orientering og pedagogiske formål. Norsk IPTV etterstreber å holde informasjonen oppdatert og korrekt, men gir ingen garantier av noe slag, verken uttrykte eller underforståtte, om fullstendighet, nøyaktighet eller pålitelighet.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-white mb-3">2. Tredjepartstjenester & Varemerker</h2>
        <p>
          Alle produktnavn, logoer, merkevarer og registrerte varemerker nevnt på dette nettstedet tilhører sine respektive eiere. Bruken av disse navnene og merkene innebærer ingen tilknytning til, sponsing av eller godkjenning fra de respektive rettighetshaverne. Norsk IPTV er en uavhengig tjeneste.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-white mb-3">3. Brukerens Eget Ansvar</h2>
        <p>
          Det er brukerens eget ansvar å gjøre seg kjent med og overholde gjeldende lover og forskrifter i sitt eget land eller jurisdiksjon vedrørende strømming av medieinnhold og bruk av IPTV-teknologi over internett.
        </p>
      </section>

      <section>
        <h2 class="text-xl font-bold text-white mb-3">4. Begrensning av Ansvar</h2>
        <p>
          Under ingen omstendigheter skal Norsk IPTV, dets eiere eller samarbeidspartnere holdes ansvarlige for direkte, indirekte eller tilfeldige tap som måtte oppstå som følge av bruken av, eller manglende evne til å bruke, tjenestene på dette nettstedet.
        </p>
      </section>

      <section class="pt-4 border-t border-white/10">
        <h2 class="text-xl font-bold text-white mb-3">5. Kontakt for Juridiske Henvendelser</h2>
        <p>
          Dersom du har spørsmål vedrørende denne ansvarsfraskrivelsen, ta gjerne kontakt på:
        </p>
        <div class="mt-3 p-4 rounded-xl bg-white/5 border border-white/5 space-y-1 font-mono text-xs sm:text-sm">
          <div>E-post: <a href="mailto:contact@norsk-iptv.net" class="text-[#8b5cf6] hover:underline">contact@norsk-iptv.net</a> / <a href="mailto:support@castvera.com" class="text-[#06b6d4] hover:underline">support@castvera.com</a></div>
        </div>
      </section>

    </div>

  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
