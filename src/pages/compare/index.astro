---
import Layout from '../../layouts/Layout.astro';
import StickyHeader from '../../components/StickyHeader.astro';
import Footer from '../../components/Footer.astro';
import FloatingWhatsApp from '../../components/FloatingWhatsApp.astro';
import LiveScores from '../../components/LiveScores.astro';
import { Scale, ArrowRight, CheckCircle2, Trophy, Sparkles } from 'lucide-astro';

const breadcrumbs = [
  { name: 'Hjem', item: '/' },
  { name: 'Sammenligninger', item: '/compare' },
];

const comparisons = [
  {
    title: 'Norsk IPTV vs Nordic Prime',
    slug: 'norsk-iptv-vs-nordicprime',
    description: 'Sammenligning av serverstabilitet, bildekvalitet under sport og prisnivå mellom Norsk IPTV og Nordic Prime.',
    badge: 'Mest Lest'
  },
  {
    title: 'Norsk IPTV vs IPTV Norge',
    slug: 'norsk-iptv-vs-iptvnorge',
    description: 'En grundig test av oppetid, app-kompatibilitet og kundeservice i Norge.',
    badge: 'Anbefalt Test'
  },
  {
    title: 'Norsk IPTV vs Norsk IPTV Live',
    slug: 'norsk-iptv-vs-norskiptvlive',
    description: 'Få full oversikt over bildeoverføring i 4K, 60fps sport og refusjonsgarantier.',
    badge: 'Prissammenligning'
  }
];
---

<Layout
  title="IPTV Sammenligninger 2026 — Se Hvilken Leverandør Som Er Best"
  description="Uavhengige sammenligninger og tester av Norsk IPTV mot de største IPTV-leverandørene i det norske markedet."
  breadcrumbs={breadcrumbs}
>
  <StickyHeader />

  <main class="py-16 md:py-24 max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-4">
        <Scale class="w-3.5 h-3.5 text-[#06b6d4]" />
        <span>Uavhengig Kjøpsveiledning</span>
      </div>
      <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
        IPTV Tester & <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">Sammenligninger</span>
      </h1>
      <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
        Vi tester og evaluerer markedets ledende IPTV-tjenester på bildekvalitet, serverstabilitet, EPG og pris for å hjelpe deg med å ta et trygt valg.
      </p>
    </div>

    <!-- LiveScores Infinite Loop Carousel -->
    <div class="mb-16 -mx-4 sm:-mx-6 lg:-mx-8">
      <LiveScores />
    </div>

    <!-- Comparisons Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {comparisons.map((item) => (
        <a
          href={`/compare/${item.slug}`}
          class="group rounded-3xl bg-[#0e0e17] border border-white/10 hover:border-[#8b5cf6]/50 p-7 transition-all duration-300 transform hover:-translate-y-1 shadow-xl hover:shadow-[#8b5cf6]/10 flex flex-col justify-between"
        >
          <div>
            <div class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider px-2.5 py-0.5 rounded-full bg-[#8b5cf6]/20 text-[#c084fc] border border-[#8b5cf6]/30 mb-4">
              <Trophy class="w-3 h-3 text-[#06b6d4]" />
              <span>{item.badge}</span>
            </div>
            <h2 class="text-xl font-bold text-white group-hover:text-[#a78bfa] transition-colors mb-3">
              {item.title}
            </h2>
            <p class="text-xs sm:text-sm text-gray-400 leading-relaxed mb-6">
              {item.description}
            </p>
          </div>

          <div class="pt-4 border-t border-white/5 flex items-center justify-between text-xs font-bold text-[#06b6d4] group-hover:text-white transition-colors">
            <span>Les Sammenligningen</span>
            <ArrowRight class="w-4 h-4 transform group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      ))}
    </div>

  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
