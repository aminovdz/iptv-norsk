---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import LiveScores from '../components/LiveScores.astro';
import { Gift, Users, Sparkles, ArrowRight, MessageCircle, CheckCircle2, ShieldCheck, Trophy } from 'lucide-astro';

const breadcrumbs = [
  { name: 'Hjem', item: '/' },
  { name: 'Verveprogram', item: '/referral' },
];

const tiers = [
  {
    friends: "1 Venn",
    reward: "1 Måned Gratis",
    description: "Både du og vennen din mottar 1 ekstra måned gratis IPTV lagt til kontoen.",
    popular: false
  },
  {
    friends: "3 Venner",
    reward: "3 Måneder Gratis",
    description: "Nyt 3 hele måneder med uavbrutt 4K IPTV underholdning uten kostnad.",
    popular: true
  },
  {
    friends: "5 Venner",
    reward: "6 Måneder VIP",
    description: "Få et halvt år med gratis VIP-strømming og prioritert support.",
    popular: false
  }
];

const whatsappReferralUrl = "https://wa.me/213550592200?text=Hei!%20Jeg%20ønsker%20min%20personlige%20vervekode%20for%20Norsk%20IPTV.";
---

<Layout
  title="Verveprogram — Tjen Gratis IPTV Måneder | Norsk IPTV"
  description="Verv venner og familie til Norsk IPTV og tjen opptil 6 måneder med gratis 4K IPTV-strømming. Få din personlige vervekode i dag."
  breadcrumbs={breadcrumbs}
>
  <StickyHeader />

  <main class="py-16 md:py-24">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Hero Section -->
      <div class="text-center max-w-3xl mx-auto mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-4">
          <Gift class="w-3.5 h-3.5 text-[#06b6d4]" />
          <span>Eksklusivt Verveprogram</span>
        </div>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
          Verv En Venn & Få <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">Gratis IPTV Måneder</span>
        </h1>
        <p class="text-base sm:text-lg text-gray-300 leading-relaxed mb-8">
          Er du fornøyd med stabiliteten og bildekvaliteten hos Norsk IPTV? Del gleden med venner, familie eller kolleger og bli belønnet med gratis måneder!
        </p>

        <a
          href={whatsappReferralUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-8 py-4 rounded-2xl bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4] hover:from-[#7c3aed] hover:to-[#0891b2] text-white font-bold text-sm uppercase tracking-wider shadow-xl shadow-[#8b5cf6]/30 transition-all transform hover:-translate-y-0.5"
        >
          <MessageCircle class="w-5 h-5" />
          <span>Få Din Vervekode på WhatsApp</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>

      <!-- LiveScores Infinite Loop Carousel -->
      <div class="mb-20 -mx-4 sm:-mx-6 lg:-mx-8">
        <LiveScores />
      </div>

      <!-- Reward Tiers Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-20">
        {tiers.map((tier) => (
          <div class={`rounded-3xl p-8 flex flex-col justify-between transition-all duration-300 ${
            tier.popular
              ? 'glass-card-featured border-[#8b5cf6]/60 shadow-2xl shadow-[#8b5cf6]/20 transform md:-translate-y-2'
              : 'glass-card'
          }`}>
            <div>
              <div class="flex items-center justify-between mb-4">
                <span class="text-xs font-bold uppercase tracking-wider text-gray-400">{tier.friends}</span>
                {tier.popular && (
                  <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-[#8b5cf6]/30 text-[#e9d5ff] border border-[#8b5cf6]/40">
                    Mest Populær
                  </span>
                )}
              </div>
              <h3 class="text-2xl font-extrabold text-white mb-3 text-transparent bg-clip-text bg-gradient-to-r from-white to-[#a78bfa]">
                {tier.reward}
              </h3>
              <p class="text-sm text-gray-400 leading-relaxed mb-6">
                {tier.description}
              </p>
            </div>

            <div class="pt-4 border-t border-white/10 flex items-center gap-2 text-xs text-[#06b6d4] font-semibold">
              <CheckCircle2 class="w-4 h-4" />
              <span>Gjelder for alle årsabonnement</span>
            </div>
          </div>
        ))}
      </div>

      <!-- How it Works Steps -->
      <div class="rounded-3xl bg-[#0e0e17] border border-white/10 p-8 sm:p-12 mb-16">
        <h2 class="text-2xl font-bold text-white text-center mb-10">Slik Fungerer Det i 3 Enkle Steg</h2>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="w-14 h-14 rounded-2xl bg-[#8b5cf6]/20 border border-[#8b5cf6]/30 text-[#8b5cf6] font-bold text-xl flex items-center justify-center mx-auto mb-4 font-mono">
              1
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Be om Vervekode</h3>
            <p class="text-xs sm:text-sm text-gray-400">Kontakt vår WhatsApp-support og motta din unike personlige vervekode.</p>
          </div>

          <div class="text-center">
            <div class="w-14 h-14 rounded-2xl bg-[#06b6d4]/20 border border-[#06b6d4]/30 text-[#06b6d4] font-bold text-xl flex items-center justify-center mx-auto mb-4 font-mono">
              2
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Del med Venner</h3>
            <p class="text-xs sm:text-sm text-gray-400">Vennen din oppgir koden ved bestilling av 12 Måneder VIP abonnement.</p>
          </div>

          <div class="text-center">
            <div class="w-14 h-14 rounded-2xl bg-emerald-500/20 border border-emerald-500/30 text-emerald-400 font-bold text-xl flex items-center justify-center mx-auto mb-4 font-mono">
              3
            </div>
            <h3 class="text-lg font-bold text-white mb-2">Motta Gratis Måneder</h3>
            <p class="text-xs sm:text-sm text-gray-400">Vi legger automatisk til din gratis bonusmåned på din eksisterende konto umiddelbart!</p>
          </div>
        </div>
      </div>

    </div>
  </main>

  <Footer />
  <FloatingWhatsApp />
</Layout>
