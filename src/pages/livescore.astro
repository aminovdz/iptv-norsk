}

const liveScoresFaqs = [
  {
    question: "Kan jeg se alle Premier League kamper inkludert klokken 16:00 på lørdager?",
    answer: "Ja, 100%. Mens tradisjonelle TV-pakker i Norge og Storbritannia ofte har blackout-begrensninger, sender Norsk IPTV samtlige Premier League-oppgjør direkte i ukomprimert 4K og Full HD 60FPS uten restriksjoner."
  },
  {
    question: "Hvor raskt oppdateres livescore i forhold til TV-sendingen?",
    answer: "Våre dedikerte IPTV-sportsstrømmer har ekstremt lav forsinkelse (under 5 sekunder). Dette betyr at du opplever målene direkte på TV-skjermen før varslingsapper og bettingsider rekker å oppdatere seg."
  },
  {
    question: "Dekker Norsk IPTV norsk Eliteserien, vintersport og Champions League?",
    answer: "Ja, alle runder i Eliteserien, OBOS-ligaen, Champions League, Europa League, Formel 1, samt all norsk vintersport (langrenn, skiskyting, alpint) er tilgjengelig med norske og internasjonale kommentatorspor."
  },
  {
    question: "Hvordan kan jeg starte strømmingen med en gang?",
    answer: "Du sender oss en melding på WhatsApp eller bestiller 12-måneders VIP pakken. Du mottar dine personlige innloggingsdetaljer innen 2 minutter og kan begynne å se på din Smart TV, Firestick eller Apple TV umiddelbart."
  }
];

const seoTitle = "Direktesendt Sport & Livescore Norge (2026) | Se Kamper i 4K UHD";
const seoDescription = "Sanntids livescore og kampoppsett for Eliteserien, Premier League, Champions League og internasjonal sport. Strøm alle storkamper direkte i 4K 60FPS på Norsk IPTV.";

const breadcrumbs = [
  { name: 'Hjem', item: '/' },
  { name: 'Livescore Kampsenter', item: '/livescore' },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": liveScoresFaqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
};
---

<Layout
