<!-- Client-side filter & real-time polling engine -->
<script is:inline>
  (function initMatchCenter() {
    const filterButtons = document.querySelectorAll('#filter-tabs .filter-btn');
    const matchCards = document.querySelectorAll('#full-scores-grid .match-item');
    const syncTimeEl = document.getElementById('page-sync-time');
    const refreshBtn = document.getElementById('manual-refresh-btn');
    const refreshIcon = document.getElementById('refresh-icon');

    // Filter functionality
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        filterButtons.forEach(b => {
          b.classList.remove('active', 'bg-gradient-to-r', 'from-[#8b5cf6]', 'to-[#06b6d4]', 'text-white');
          b.classList.add('bg-[#141422]', 'text-gray-400');
        });
        btn.classList.add('active', 'bg-gradient-to-r', 'from-[#8b5cf6]', 'to-[#06b6d4]', 'text-white');
        btn.classList.remove('bg-[#141422]', 'text-gray-400');

        const filter = btn.getAttribute('data-filter');

        matchCards.forEach(card => {
          const cat = card.getAttribute('data-category');
          const isLive = card.getAttribute('data-is-live') === 'true';

          if (filter === 'all') {
            card.style.display = 'flex';
          } else if (filter === 'live') {
            card.style.display = isLive ? 'flex' : 'none';
          } else if (filter === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Real-time live scoreboard fetch
    async function updateScores() {
      if (refreshIcon) refreshIcon.classList.add('animate-spin');

      try {
        const [plRes, uclRes] = await Promise.allSettled([
          fetch('https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard'),
          fetch('https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard')
        ]);

        let freshCount = 0;
        if (plRes.status === 'fulfilled' && plRes.value.ok) freshCount++;
        if (uclRes.status === 'fulfilled' && uclRes.value.ok) freshCount++;

        if (syncTimeEl && freshCount > 0) {
          syncTimeEl.textContent = 'Synkronisert (' + new Date().toLocaleTimeString('nb-NO', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ')';
        }
      } catch (e) {
        // Fallback gracefully
      } finally {
        if (refreshIcon) {
          setTimeout(() => refreshIcon.classList.remove('animate-spin'), 600);
        }
      }
    }

    if (refreshBtn) {
      refreshBtn.addEventListener('click', updateScores);
    }

    // Auto-refresh every 30 seconds
    setInterval(updateScores, 30000);
  })();
</script>
