---
import Layout from '../layouts/Layout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import ExitPopup from '../components/ExitPopup.astro';
import { 
  Tv, 
  Activity, 
  ArrowRight, 
  RotateCw,
  Trophy,
  ShieldCheck,
  Zap,
  Play,
  CheckCircle2,
  MessageCircle,
  Clock,
  Sparkles
} from 'lucide-astro';

interface Match {
  id: string;
  league: string;
  category: string;
  status: string;
  isLive: boolean;
  minute?: string;
  venue?: string;
  homeTeam: {
    name: string;
    logo: string;
    score: string;
  };
  awayTeam: {
    name: string;
    logo: string;
    score: string;
  };
}

let serverMatches: Match[] = [];

try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 1200);

  const [plRes, uclRes] = await Promise.allSettled([
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard", {
      headers: { "Accept": "application/json", "User-Agent": "Mozilla/5.0 (compatible; NorskIPTVBot/2.0)" },
      signal: controller.signal
    }),
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard", {
      headers: { "Accept": "application/json", "User-Agent": "Mozilla/5.0 (compatible; NorskIPTVBot/2.0)" },
      signal: controller.signal
    })
  ]);
  clearTimeout(timeoutId);

  const rawEvents: any[] = [];
  if (plRes.status === 'fulfilled' && plRes.value.ok) {
    const plData = await plRes.value.json();
    if (plData.events) {
      plData.events.forEach((evt: any) => {
        evt._leagueCategory = 'premier-league';
        rawEvents.push(evt);
      });
    }
  }
  if (uclRes.status === 'fulfilled' && uclRes.value.ok) {
    const uclData = await uclRes.value.json();
    if (uclData.events) {
      uclData.events.forEach((evt: any) => {
        evt._leagueCategory = 'champions-league';
        rawEvents.push(evt);
      });
    }
  }

  if (rawEvents.length > 0) {
    serverMatches = rawEvents.map((evt: any) => {
      const comp = evt.competitions?.[0];
      const home = comp?.competitors?.find((c: any) => c.homeAway === 'home') || comp?.competitors?.[0];
      const away = comp?.competitors?.find((c: any) => c.homeAway === 'away') || comp?.competitors?.[1];
      const state = evt.status?.type?.state;
      const isLive = state === 'in';
      const displayStatus = evt.status?.type?.shortDetail || (isLive ? (evt.status?.displayClock || 'LIVE') : 'FT');

      return {
        id: String(evt.id),
        league: evt.season?.name || (evt.name?.includes('Champions') ? 'Champions League' : 'Premier League'),
        category: evt._leagueCategory || 'premier-league',
        status: displayStatus,
        isLive: isLive,
        minute: evt.status?.displayClock || (isLive ? 'LIVE' : 'FT'),
        venue: comp?.venue?.fullName || 'Stadion',
        homeTeam: {
          name: home?.team?.shortDisplayName || home?.team?.name || 'Hjemmelag',
          logo: home?.team?.logo || 'https://a.espncdn.com/i/teamlogos/soccer/500/default.png',
          score: home?.score !== undefined ? String(home.score) : '-'
        },
        awayTeam: {
          name: away?.team?.shortDisplayName || away?.team?.name || 'Bortelag',
          logo: away?.team?.logo || 'https://a.espncdn.com/i/teamlogos/soccer/500/default.png',
          score: away?.score !== undefined ? String(away.score) : '-'
        }
      };
    });
  }
} catch (e) {
  serverMatches = [];
}

// Fallback high-profile Norwegian and European fixtures if build network is restricted
if (serverMatches.length === 0) {
  serverMatches = [
    {
