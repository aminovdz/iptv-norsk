---
import { 
  Zap, 
  Tv, 
  ShieldCheck, 
  Smartphone, 
  Clock, 
  RotateCcw, 
  Headphones, 
  Flame,
  Wifi,
  Sparkles,
  Layers,
  Radio
} from 'lucide-astro';

const features = [
  {
    icon: Zap,
    title: "Anti-Freeze™ 9.0 Teknologi",
    description: "Våre europeiske serverklynger med balansert belastning sikrer 100% bufferfri strømming under direktesendte sportsbegivenheter.",
    tag: "99.9% Stabilitet"
  },
  {
    icon: Tv,
    title: "Ekte 4K Ultra HD & 60 FPS",
    description: "Krystallklar bildekvalitet med høy bildefrekvens for sport, underholdning og direktesendte sendinger i toppoppløsning.",
    tag: "Premium Kvalitet"
  },
  {
    icon: Radio,
    title: "Elektronisk Programguide (EPG)",
    description: "Komplett, interaktiv TV-guide som oppdateres i sanntid. Se hva som går nå og planlegg ukens TV-kvelder enkelt.",
    tag: "Sanntid EPG"
  },
  {
    icon: Smartphone,
    title: "Støtte for Alle Dine Enheter",
    description: "Bruk abonnementet på Smart TV (Samsung, LG, Sony), Android TV, Fire TV Stick, Apple TV, iOS, Windows, Mac og nettbrett.",
    tag: "Multi-Plattform"
  },
  {
    icon: Clock,
    title: "Umiddelbar Automatisk Aktivering",
    description: "Motta dine personlige tilgangsdetaljer og M3U/Xtream-innstillinger direkte på WhatsApp eller e-post på under 3 minutter.",
    tag: "Rask Levering"
  },
  {
    icon: RotateCcw,
    title: "Catch-Up & 7 Dagers TV-Arkiv",
    description: "Gikk du glipp av en viktig direktesending eller en direktesendt kamp? Se programmer i opptak inntil 7 dager tilbake.",
    tag: "Spol Tilbake"
  },
  {
    icon: Headphones,
    title: "24/7 Personlig Kundesupport",
    description: "Få rask og profesjonell veiledning på norsk og engelsk direkte via WhatsApp og Telegram når du trenger bistand.",
    tag: "24/7 Hjelp"
  },
  {
    icon: ShieldCheck,
    title: "Ingen Bindingstid & Refusjonsgaranti",
    description: "Prepaid-abonnement uten automatiske trekk. Vi tilbyr 24-timers fornøydgaranti så du kan handle helt risikofritt.",
    tag: "100% Trygt"
  }
];
---

<section id="features" class="py-20 md:py-28 relative overflow-hidden" aria-labelledby="features-heading">
  
  <!-- Subtle Background Gradients -->
  <div class="absolute top-1/2 left-0 w-96 h-96 bg-[#8b5cf6]/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute bottom-10 right-0 w-96 h-96 bg-[#06b6d4]/10 blur-[130px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#06b6d4]" />
        <span>Hvorfor Velge Norsk IPTV?</span>
      </div>
      <h2 id="features-heading" class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
        Konstruert for <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">Uovertruffen Stabilitet</span> & Fart
      </h2>
      <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
        Vi har investert i førsteklasses nordiske servernoder for å gi deg markedets beste <strong>IPTV Norge</strong> opplevelse. Ingen hakking, ingen ventetid, kun ren streamingglede.
      </p>
    </div>

    <!-- Feature Grid (3x3 Responsive) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      {features.map((item, index) => {
        const IconComponent = item.icon;
        return (
          <div class="group relative rounded-2xl bg-[#0e0e17]/80 hover:bg-[#121222] border border-white/10 hover:border-[#8b5cf6]/40 p-6 sm:p-7 transition-all duration-300 transform hover:-translate-y-1 shadow-lg hover:shadow-[#8b5cf6]/10 flex flex-col justify-between">
            
            <div>
              <!-- Top Row: Icon & Tag -->
              <div class="flex items-center justify-between mb-5">
                <div class="w-12 h-12 rounded-xl bg-gradient-to-tr from-[#8b5cf6]/20 to-[#06b6d4]/20 border border-[#8b5cf6]/30 flex items-center justify-center text-[#06b6d4] group-hover:text-white group-hover:scale-105 transition-all">
                  <IconComponent class="w-6 h-6" />
                </div>
                <span class="text-[11px] font-semibold px-2.5 py-1 rounded-full bg-white/5 border border-white/10 text-gray-400 group-hover:text-[#a78bfa] group-hover:border-[#8b5cf6]/30 transition-colors">
                  {item.tag}
                </span>
              </div>

              <!-- Content Heading (H3) -->
              <h3 class="text-lg font-bold text-white mb-2.5 group-hover:text-transparent group-hover:bg-clip-text group-hover:bg-gradient-to-r group-hover:from-white group-hover:to-[#a78bfa] transition-all">
                {item.title}
              </h3>

              <!-- Description -->
              <p class="text-sm text-gray-400 leading-relaxed">
                {item.description}
              </p>
            </div>

            <!-- Bottom Indicator Line -->
            <div class="mt-6 pt-4 border-t border-white/5 flex items-center gap-1 text-xs font-semibold text-gray-500 group-hover:text-[#06b6d4] transition-colors">
              <span>Inkludert i alle planer</span>
            </div>

          </div>
        );
      })}
    </div>

  </div>
</section>
