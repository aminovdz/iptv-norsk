---
import { X, Gift, MessageCircle, ArrowRight, ShieldCheck, Zap, Sparkles } from 'lucide-astro';

const whatsappUrl = "https://wa.me/18036582620?text=Hei!%20Jeg%20ønsker%20spesialtilbudet:%20Abonner%20nå%20og%20få%201%20måned%20gratis!";
---

<!-- Exit Intent Modal Overlay -->
<div
  id="exit-popup-modal"
  class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-popup-title"
>
  <!-- Modal Card -->
  <div class="relative w-full max-w-lg rounded-3xl bg-gradient-to-b from-[#181432] via-[#0f0e1d] to-[#0a0a14] border border-[#8b5cf6]/50 p-6 sm:p-8 shadow-2xl shadow-[#8b5cf6]/25 transform scale-95 transition-transform duration-300">
    
    <!-- Close Button -->
    <button
      type="button"
      id="exit-popup-close"
      class="absolute top-4 right-4 p-2 rounded-full bg-white/5 hover:bg-white/15 text-gray-400 hover:text-white border border-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-[#8b5cf6]"
      aria-label="Lukk tilbud"
    >
      <X class="w-5 h-5" />
    </button>

    <!-- Top Badge -->
    <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#8b5cf6]/20 border border-[#8b5cf6]/40 text-xs font-bold text-[#c084fc] mb-4">
      <Gift class="w-3.5 h-3.5" />
      <span>EKSKLUSIVT SPESIALTILBUD</span>
    </div>

    <!-- Title -->
    <h3 id="exit-popup-title" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight leading-tight mb-3">
      Vent! Ikke gå glipp av <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">1 Måned Gratis</span>
    </h3>

    <!-- Description -->
    <p class="text-sm sm:text-base text-gray-300 leading-relaxed mb-6">
      Abonner på Norsk IPTV nå og få <strong class="text-white">1 ekstra måned helt gratis</strong> lagt til ditt abonnement. Opplev Norges mest stabile 4K IPTV uten bindingstid.
    </p>

    <!-- Highlight Benefits Box -->
    <div class="rounded-2xl bg-white/5 border border-white/10 p-4 mb-6 space-y-2 text-xs sm:text-sm text-gray-200">
      <div class="flex items-center gap-2">
        <Zap class="w-4 h-4 text-[#06b6d4] shrink-0" />
        <span>Ukomprimert 4K & Anti-Freeze™ 9.0 strømming</span>
      </div>
      <div class="flex items-center gap-2">
        <ShieldCheck class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>24-timers full refusjonsgaranti</span>
      </div>
    </div>

    <!-- Direct WhatsApp Offer CTA -->
    <div class="space-y-3">
      <a
        href={whatsappUrl}
        id="exit-popup-cta"
        target="_blank"
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2.5 py-4 px-6 rounded-2xl bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4] hover:from-[#7c3aed] hover:to-[#0891b2] text-white font-bold text-sm uppercase tracking-wider shadow-lg shadow-[#8b5cf6]/30 transition-all duration-200 transform hover:-translate-y-0.5"
      >
        <MessageCircle class="w-5 h-5 text-white" />
        <span>Få 1 Måned Gratis på WhatsApp</span>
        <ArrowRight class="w-4 h-4" />
      </a>

      <button
        type="button"
        id="exit-popup-dismiss"
        class="w-full text-center text-xs text-gray-400 hover:text-gray-200 py-1 transition-colors"
      >
        Nei takk, jeg vil fortsette uten gratis måned
      </button>
    </div>

  </div>
</div>

<script>
  const STORAGE_KEY = 'norsk_iptv_exit_popup_24h';
  const modal = document.getElementById('exit-popup-modal');
  const closeBtn = document.getElementById('exit-popup-close');
  const dismissBtn = document.getElementById('exit-popup-dismiss');
  const ctaBtn = document.getElementById('exit-popup-cta');

  function isShownRecently() {
    const lastShown = localStorage.getItem(STORAGE_KEY);
    if (!lastShown) return false;
    const now = new Date().getTime();
    return now - parseInt(lastShown, 10) < 24 * 60 * 60 * 1000; // 24 hours
  }

  function markAsShown() {
    localStorage.setItem(STORAGE_KEY, new Date().getTime().toString());
  }

  function showModal() {
    if (!modal || isShownRecently()) return;
    markAsShown();
    modal.classList.remove('opacity-0', 'pointer-events-none');
    modal.classList.add('opacity-100', 'pointer-events-auto');
  }

  function closeModal() {
    if (!modal) return;
    modal.classList.remove('opacity-100', 'pointer-events-auto');
    modal.classList.add('opacity-0', 'pointer-events-none');
  }

  if (modal) {
    // Mouse leave viewport trigger (Desktop)
    document.addEventListener('mouseleave', (e) => {
      if (e.clientY <= 0) {
        showModal();
      }
    });

    // Close handlers
    closeBtn?.addEventListener('click', closeModal);
    dismissBtn?.addEventListener('click', closeModal);
    ctaBtn?.addEventListener('click', closeModal);

    // Backdrop click
    modal.addEventListener('click', (e) => {
      if (e.target === modal) {
        closeModal();
      }
    });
  }
</script>
