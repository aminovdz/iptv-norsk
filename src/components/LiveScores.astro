---
import { Trophy, Activity, Tv, ArrowRight, Sparkles, Play } from 'lucide-astro';

interface MatchItem {
  league: string;
  homeTeam: string;
  awayTeam: string;
  homeScore?: number;
  awayScore?: number;
  status: 'LIVE' | 'UPCOMING' | 'FINISHED';
  time: string;
  quality: string;
}

const matches: MatchItem[] = [
  {
    league: "Eliteserien",
    homeTeam: "Bodø/Glimt",
    awayTeam: "Rosenborg",
    homeScore: 2,
    awayScore: 1,
    status: 'LIVE',
    time: "68'",
    quality: "4K UHD 60fps"
  },
  {
    league: "Eliteserien",
    homeTeam: "Brann",
    awayTeam: "Molde FK",
    homeScore: 1,
    awayScore: 1,
    status: 'LIVE',
    time: "74'",
    quality: "4K UHD 60fps"
  },
  {
    league: "Champions League",
    homeTeam: "Arsenal",
    awayTeam: "Bayern München",
    status: 'UPCOMING',
    time: "21:00",
    quality: "4K HDR"
  },
  {
    league: "Eredivisie",
    homeTeam: "Ajax",
    awayTeam: "Feyenoord",
    homeScore: 3,
    awayScore: 2,
    status: 'FINISHED',
    time: "Fulltid",
    quality: "4K UHD"
  }
];
---

<section class="py-16 relative overflow-hidden bg-white/[0.01]" aria-labelledby="livescores-heading">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Header -->
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-2">
          <Activity class="w-3.5 h-3.5 text-[#06b6d4] animate-pulse" />
          <span>Direktesendt Sport & Resultatsenter</span>
        </div>
        <h2 id="livescores-heading" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
          Strøm Alle Storkamper Direkte i <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">4K Ultra HD</span>
        </h2>
      </div>

      <a
        href="#pricing"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white/5 hover:bg-white/10 text-gray-200 hover:text-white border border-white/10 text-xs font-bold transition-all"
      >
        <span>Få Tilgang Til Alle Kamper</span>
        <ArrowRight class="w-3.5 h-3.5 text-[#8b5cf6]" />
      </a>
    </div>

    <!-- Match Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
      {matches.map((match) => (
        <div class="rounded-2xl bg-[#0e0e17] border border-white/10 hover:border-[#8b5cf6]/40 p-5 transition-all duration-200 group flex flex-col justify-between">
          
          <div>
            <!-- Top Match Status Bar -->
            <div class="flex items-center justify-between mb-4 text-xs">
              <span class="font-bold text-gray-400 uppercase tracking-wider text-[11px]">{match.league}</span>
              {match.status === 'LIVE' && (
                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-red-500/20 text-red-400 font-bold text-[10px] border border-red-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span>
                  {match.time}
                </span>
              )}
              {match.status === 'UPCOMING' && (
                <span class="px-2 py-0.5 rounded bg-blue-500/20 text-blue-400 font-bold text-[10px]">
                  I Kveld {match.time}
                </span>
              )}
              {match.status === 'FINISHED' && (
                <span class="px-2 py-0.5 rounded bg-white/10 text-gray-400 font-semibold text-[10px]">
                  {match.time}
                </span>
              )}
            </div>

            <!-- Teams and Scores -->
            <div class="space-y-2.5 mb-5">
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-white group-hover:text-[#a78bfa] transition-colors">{match.homeTeam}</span>
                {match.homeScore !== undefined && (
                  <span class="text-base font-extrabold text-white font-mono">{match.homeScore}</span>
                )}
              </div>
              <div class="flex items-center justify-between">
                <span class="text-sm font-bold text-white group-hover:text-[#a78bfa] transition-colors">{match.awayTeam}</span>
                {match.awayScore !== undefined && (
                  <span class="text-base font-extrabold text-white font-mono">{match.awayScore}</span>
                )}
              </div>
            </div>
          </div>

          <!-- Bottom Quality Tag & Stream Button -->
          <div class="pt-3 border-t border-white/5 flex items-center justify-between text-[11px]">
            <span class="text-gray-400 font-medium">{match.quality}</span>
            <a
              href="#pricing"
              class="inline-flex items-center gap-1 font-bold text-[#06b6d4] hover:text-white transition-colors"
            >
              <Play class="w-3 h-3 fill-current" />
              <span>Se Nå</span>
            </a>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
