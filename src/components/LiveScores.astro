---
import { ArrowRight, Activity, Tv, Sparkles, Play } from 'lucide-astro';

interface Match {
  id: string;
  league: string;
  status: string;
  isLive: boolean;
  minute?: string;
  homeTeam: {
    name: string;
    logo: string;
    score: string;
  };
  awayTeam: {
    name: string;
    logo: string;
    score: string;
  };
}

let matches: Match[] = [];

try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 1200);

  // Fetch real matches from ESPN Premier League & Champions League scoreboards
  const [plRes, uclRes] = await Promise.allSettled([
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard", {
      headers: { "Accept": "application/json", "User-Agent": "Mozilla/5.0 (compatible; NorskIPTVBot/2.0)" },
      signal: controller.signal
    }),
    fetch("https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard", {
      headers: { "Accept": "application/json", "User-Agent": "Mozilla/5.0 (compatible; NorskIPTVBot/2.0)" },
      signal: controller.signal
    })
  ]);
  clearTimeout(timeoutId);

  const rawEvents: any[] = [];
  if (plRes.status === 'fulfilled' && plRes.value.ok) {
    const plData = await plRes.value.json();
    if (plData.events) rawEvents.push(...plData.events);
  }
  if (uclRes.status === 'fulfilled' && uclRes.value.ok) {
    const uclData = await uclRes.value.json();
    if (uclData.events) rawEvents.push(...uclData.events);
  }

  if (rawEvents.length > 0) {
    matches = rawEvents.slice(0, 10).map((evt: any) => {
      const comp = evt.competitions?.[0];
      const home = comp?.competitors?.find((c: any) => c.homeAway === 'home') || comp?.competitors?.[0];
      const away = comp?.competitors?.find((c: any) => c.homeAway === 'away') || comp?.competitors?.[1];
      const state = evt.status?.type?.state;
      const isLive = state === 'in';
      const displayStatus = evt.status?.type?.shortDetail || (isLive ? (evt.status?.displayClock || 'LIVE') : 'FT');

      return {
        id: String(evt.id),
        league: evt.season?.name || (evt.name?.includes('Champions') ? 'Champions League' : 'Premier League'),
        status: displayStatus,
        isLive: isLive,
        minute: evt.status?.displayClock || (isLive ? 'LIVE' : 'FT'),
        homeTeam: {
          name: home?.team?.shortDisplayName || home?.team?.name || 'Hjemmelag',
          logo: home?.team?.logo || 'https://a.espncdn.com/i/teamlogos/soccer/500/default.png',
          score: home?.score !== undefined ? String(home.score) : '-'
        },
        awayTeam: {
          name: away?.team?.shortDisplayName || away?.team?.name || 'Bortelag',
          logo: away?.team?.logo || 'https://a.espncdn.com/i/teamlogos/soccer/500/default.png',
          score: away?.score !== undefined ? String(away.score) : '-'
        }
      };
    });
  }
} catch (e) {
  matches = [];
}

// Fallback high-profile Eliteserien, Premier League and Champions League fixtures
if (matches.length === 0) {
  matches = [
    {
      id: 'nor-1',
      league: 'Eliteserien',
      status: "LIVE 68'",
      isLive: true,
      minute: "68'",
      homeTeam: { name: 'Bodø/Glimt', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/7750.png', score: '2' },
      awayTeam: { name: 'Rosenborg', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/125.png', score: '1' }
    },
    {
      id: 'nor-2',
      league: 'Eliteserien',
      status: "LIVE 74'",
      isLive: true,
      minute: "74'",
      homeTeam: { name: 'SK Brann', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/124.png', score: '1' },
      awayTeam: { name: 'Molde FK', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/123.png', score: '1' }
    },
    {
      id: 'pl-1',
      league: 'Premier League',
      status: "FT",
      isLive: false,
      minute: "FT",
      homeTeam: { name: 'Liverpool', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/364.png', score: '2' },
      awayTeam: { name: 'Man City', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/382.png', score: '1' }
    },
    {
      id: 'pl-2',
      league: 'Premier League',
      status: "FT",
      isLive: false,
      minute: "FT",
      homeTeam: { name: 'Arsenal', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/359.png', score: '3' },
      awayTeam: { name: 'Chelsea', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/363.png', score: '1' }
    },
    {
      id: 'ucl-1',
      league: 'Champions League',
      status: "I Kveld 21:00",
      isLive: false,
      minute: "I Kveld",
      homeTeam: { name: 'Real Madrid', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/86.png', score: '-' },
      awayTeam: { name: 'Bayern München', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/132.png', score: '-' }
    },
    {
      id: 'ucl-2',
      league: 'Champions League',
      status: "I Kveld 21:00",
      isLive: false,
      minute: "I Kveld",
      homeTeam: { name: 'Barcelona', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/83.png', score: '-' },
      awayTeam: { name: 'Paris Saint-Germain', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/160.png', score: '-' }
    },
    {
      id: 'nor-3',
      league: 'Eliteserien',
      status: "FT",
      isLive: false,
      minute: "FT",
      homeTeam: { name: 'Viking FK', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/7751.png', score: '3' },
      awayTeam: { name: 'Vålerenga', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/126.png', score: '2' }
    },
    {
      id: 'pl-3',
      league: 'Premier League',
      status: "FT",
      isLive: false,
      minute: "FT",
      homeTeam: { name: 'Man United', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/360.png', score: '2' },
      awayTeam: { name: 'Tottenham', logo: 'https://a.espncdn.com/i/teamlogos/soccer/500/367.png', score: '0' }
    }
  ];
}

// Duplicate matches array for a seamless 100% gapless infinite CSS marquee loop
const carouselMatches = [...matches, ...matches];
---

<section id="sports" class="py-10 bg-[#060609] border-y border-white/10 relative overflow-hidden" aria-label="Sanntids Kampsenter og Resultater">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-5">
    
    <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
      <div class="flex items-center gap-3">
        <div class="flex h-3 w-3 relative">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#06b6d4] opacity-75"></span>
          <span class="relative inline-flex rounded-full h-3 w-3 bg-[#06b6d4]"></span>
        </div>
        <div>
          <h2 class="text-lg sm:text-xl font-black text-white flex items-center gap-2">
            <span>Direktesendt Sport & Resultatsenter</span>
            <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-[#8b5cf6]/20 text-[#a78bfa] border border-[#8b5cf6]/30 uppercase tracking-wider">
              LOOP KARUSELL
            </span>
          </h2>
          <p class="text-xs text-gray-400">Klikk på en kamp for å åpne Livescore Kampsenter & 4K direktesendinger</p>
        </div>
      </div>

      <div class="flex items-center gap-3 w-full sm:w-auto justify-between sm:justify-end">
        <div class="text-xs text-gray-400 flex items-center gap-2">
          <Activity class="w-3.5 h-3.5 text-[#06b6d4] animate-pulse" />
          <span id="live-sync-indicator" class="text-[#06b6d4] font-semibold">Live Feed Synkronisert</span>
        </div>

        <a
          href="/livescore"
          class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-gradient-to-r from-[#8b5cf6]/20 to-[#06b6d4]/20 hover:from-[#8b5cf6] hover:to-[#06b6d4] text-white border border-[#8b5cf6]/40 text-xs font-bold uppercase tracking-wider transition-all duration-200 shadow-md group"
          title="Åpne komplett kampsenter og livescore"
        >
          <span>Full Resultatoversikt</span>
          <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
        </a>
      </div>
    </div>
  </div>

  <!-- Infinite Loop Carousel Wrapper -->
  <div class="relative w-full overflow-hidden">
    <!-- Left and right gradient fade masks -->
    <div class="pointer-events-none absolute left-0 top-0 bottom-0 w-8 sm:w-24 bg-gradient-to-r from-[#060609] via-[#060609]/80 to-transparent z-10"></div>
    <div class="pointer-events-none absolute right-0 top-0 bottom-0 w-8 sm:w-24 bg-gradient-to-l from-[#060609] via-[#060609]/80 to-transparent z-10"></div>

    <!-- Outer scrollable/interactive container -->
    <div 
      id="live-scores-carousel-container" 
      class="overflow-x-auto no-scrollbar scroll-smooth cursor-pointer"
      title="Klikk for å åpne Livescore Kampsenter"
    >
      <div 
        id="live-carousel-track" 
        class="animate-loop-scroll hover:[animation-play-state:paused] flex gap-4 px-4 py-2"
      >
        {carouselMatches.map((m) => {
          return (
            <a
              href="/livescore"
              class="match-card group/card block w-[280px] sm:w-[320px] shrink-0 rounded-2xl bg-[#0e0e17] border border-white/10 p-4 hover:border-[#8b5cf6]/60 hover:bg-[#141424] hover:shadow-[0_0_25px_rgba(139,92,246,0.25)] transition-all duration-200 backdrop-blur-md cursor-pointer select-none"
              data-match-id={m.id}
              aria-label={`Kamp: ${m.homeTeam.name} vs ${m.awayTeam.name}. Klikk for å se Livescore.`}
            >
              <!-- Card Header -->
              <div class="flex items-center justify-between text-[11px] mb-3 pb-2 border-b border-white/10">
                <span class="league-label text-gray-400 font-semibold truncate max-w-[150px] flex items-center gap-1.5">
                  <span class="text-xs">⚽</span>
                  <span>{m.league}</span>
                </span>

                {m.isLive ? (
                  <span class="status-badge flex items-center gap-1.5 text-red-400 font-bold px-2 py-0.5 rounded-full bg-red-500/10 border border-red-500/30 text-[10px]">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span>
                    <span class="status-text">{m.status}</span>
                  </span>
                ) : (
                  <span class="status-badge text-gray-400 font-medium px-2 py-0.5 rounded bg-white/5 text-[10px]">
                    <span class="status-text">{m.status}</span>
                  </span>
                )}
              </div>

              <!-- Teams & Scores Body -->
              <div class="space-y-2.5 mb-3">
                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <img 
                      src={m.homeTeam.logo} 
                      alt={m.homeTeam.name} 
                      class="home-logo w-5 h-5 object-contain shrink-0" 
                      loading="lazy" 
                      width="20" 
                      height="20" 
                      onerror="this.src='https://a.espncdn.com/i/teamlogos/soccer/500/default.png'"
                    />
                    <span class="home-name text-xs sm:text-sm font-bold text-white truncate group-hover/card:text-[#a78bfa] transition-colors">
                      {m.homeTeam.name}
                    </span>
                  </div>
                  <span class="home-score text-sm sm:text-base font-black text-[#06b6d4] ml-2 font-mono">
                    {m.homeTeam.score}
                  </span>
                </div>

                <div class="flex items-center justify-between">
                  <div class="flex items-center gap-2.5 min-w-0">
                    <img 
                      src={m.awayTeam.logo} 
                      alt={m.awayTeam.name} 
                      class="away-logo w-5 h-5 object-contain shrink-0" 
                      loading="lazy" 
                      width="20" 
                      height="20" 
                      onerror="this.src='https://a.espncdn.com/i/teamlogos/soccer/500/default.png'"
                    />
                    <span class="away-name text-xs sm:text-sm font-bold text-white truncate group-hover/card:text-[#a78bfa] transition-colors">
                      {m.awayTeam.name}
                    </span>
                  </div>
                  <span class="away-score text-sm sm:text-base font-black text-[#06b6d4] ml-2 font-mono">
                    {m.awayTeam.score}
                  </span>
                </div>
              </div>

              <!-- Card Action Banner -->
              <div class="pt-2 border-t border-white/10 flex items-center justify-between text-[11px] text-[#06b6d4] font-semibold group-hover/card:text-[#a78bfa]">
                <span class="flex items-center gap-1">
                  <span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4] inline-block"></span>
                  <span>Kampdetaljer</span>
                </span>
                <span class="flex items-center gap-1 group-hover/card:translate-x-1 transition-transform">
                  <span>Strøm 4K</span>
                  <ArrowRight class="w-3 h-3" />
                </span>
              </div>
            </a>
          );
        })}
      </div>
    </div>
  </div>
</section>

<!-- REAL-TIME CLIENT-SIDE SCOREBOARD REFRESH & CAROUSEL SYNC ENGINE -->
<script is:inline>
  (function initRealLiveScoresCarousel() {
    const API_URL = 'https://site.api.espn.com/apis/site/v2/sports/soccer/eng.1/scoreboard';
    const ALT_API_URL = 'https://site.api.espn.com/apis/site/v2/sports/soccer/uefa.champions/scoreboard';

    async function fetchRealMatches() {
      try {
        const [plRes, uclRes] = await Promise.allSettled([
          fetch(API_URL),
          fetch(ALT_API_URL)
        ]);

        let events = [];
        if (plRes.status === 'fulfilled' && plRes.value.ok) {
          const plData = await plRes.value.json();
          if (plData.events) events = events.concat(plData.events);
        }
        if (uclRes.status === 'fulfilled' && uclRes.value.ok) {
          const uclData = await uclRes.value.json();
          if (uclData.events) events = events.concat(uclData.events);
        }

        if (events.length === 0) return;

        const track = document.getElementById('live-carousel-track');
        if (!track) return;

        // Take up to 8 real matches and duplicate for the continuous loop
        const sample = events.slice(0, 8);
        const loopEvents = sample.concat(sample);

        track.innerHTML = loopEvents.map(function(evt) {
          const comp = evt.competitions && evt.competitions[0];
          if (!comp) return '';
          const home = (comp.competitors && comp.competitors.find(function(c) { return c.homeAway === 'home'; })) || (comp.competitors && comp.competitors[0]);
          const away = (comp.competitors && comp.competitors.find(function(c) { return c.homeAway === 'away'; })) || (comp.competitors && comp.competitors[1]);

          const homeName = (home && home.team && (home.team.shortDisplayName || home.team.name)) || 'Hjemmelag';
          const awayName = (away && away.team && (away.team.shortDisplayName || away.team.name)) || 'Bortelag';
          const homeLogo = (home && home.team && home.team.logo) || 'https://a.espncdn.com/i/teamlogos/soccer/500/default.png';
          const awayLogo = (away && away.team && away.team.logo) || 'https://a.espncdn.com/i/teamlogos/soccer/500/default.png';
          const homeScore = (home && home.score !== undefined) ? String(home.score) : '-';
          const awayScore = (away && away.score !== undefined) ? String(away.score) : '-';

          const state = evt.status && evt.status.type && evt.status.type.state;
          const isLive = state === 'in';
          const statusText = (evt.status && evt.status.type && evt.status.type.shortDetail) || (isLive ? 'LIVE' : 'FT');
          const leagueName = (evt.season && evt.season.name) || (evt.name && evt.name.includes('Champions') ? 'Champions League' : 'Premier League');

          const statusBadge = isLive 
            ? '<span class="status-badge flex items-center gap-1.5 text-red-400 font-bold px-2 py-0.5 rounded-full bg-red-500/10 border border-red-500/30 text-[10px]"><span class="w-1.5 h-1.5 rounded-full bg-red-400 animate-ping"></span><span>' + statusText + '</span></span>'
            : '<span class="status-badge text-gray-400 font-medium px-2 py-0.5 rounded bg-white/5 text-[10px]"><span>' + statusText + '</span></span>';

          return '<a href="/livescore" class="match-card group/card block w-[280px] sm:w-[320px] shrink-0 rounded-2xl bg-[#0e0e17] border border-white/10 p-4 hover:border-[#8b5cf6]/60 hover:bg-[#141424] hover:shadow-[0_0_25px_rgba(139,92,246,0.25)] transition-all duration-200 backdrop-blur-md cursor-pointer select-none" data-match-id="' + evt.id + '">' +
            '<div class="flex items-center justify-between text-[11px] mb-3 pb-2 border-b border-white/10">' +
              '<span class="league-label text-gray-400 font-semibold truncate max-w-[150px] flex items-center gap-1.5"><span>⚽</span><span>' + leagueName + '</span></span>' +
              statusBadge +
            '</div>' +
            '<div class="space-y-2.5 mb-3">' +
              '<div class="flex items-center justify-between">' +
                '<div class="flex items-center gap-2.5 min-w-0">' +
                  '<img src="' + homeLogo + '" alt="' + homeName + '" class="home-logo w-5 h-5 object-contain shrink-0" loading="lazy" width="20" height="20" onerror="this.src=\'https://a.espncdn.com/i/teamlogos/soccer/500/default.png\'" />' +
                  '<span class="home-name text-xs sm:text-sm font-bold text-white truncate group-hover/card:text-[#a78bfa] transition-colors">' + homeName + '</span>' +
                '</div>' +
                '<span class="home-score text-sm sm:text-base font-black text-[#06b6d4] ml-2 font-mono">' + homeScore + '</span>' +
              '</div>' +
              '<div class="flex items-center justify-between">' +
                '<div class="flex items-center gap-2.5 min-w-0">' +
                  '<img src="' + awayLogo + '" alt="' + awayName + '" class="away-logo w-5 h-5 object-contain shrink-0" loading="lazy" width="20" height="20" onerror="this.src=\'https://a.espncdn.com/i/teamlogos/soccer/500/default.png\'" />' +
                  '<span class="away-name text-xs sm:text-sm font-bold text-white truncate group-hover/card:text-[#a78bfa] transition-colors">' + awayName + '</span>' +
                '</div>' +
                '<span class="away-score text-sm sm:text-base font-black text-[#06b6d4] ml-2 font-mono">' + awayScore + '</span>' +
              '</div>' +
            '</div>' +
            '<div class="pt-2 border-t border-white/10 flex items-center justify-between text-[11px] text-[#06b6d4] font-semibold group-hover/card:text-[#a78bfa]">' +
              '<span class="flex items-center gap-1"><span class="w-1.5 h-1.5 rounded-full bg-[#06b6d4] inline-block"></span><span>Kampdetaljer</span></span>' +
              '<span class="flex items-center gap-1 group-hover/card:translate-x-1 transition-transform"><span>Strøm 4K</span><svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>' +
            '</div>' +
          '</a>';
        }).join('');

        const syncIndicator = document.getElementById('live-sync-indicator');
        if (syncIndicator) {
          syncIndicator.textContent = 'Live Feed Synkronisert (' + new Date().toLocaleTimeString('nb-NO', { hour: '2-digit', minute: '2-digit', second: '2-digit' }) + ')';
        }
      } catch (err) {
        // Keep server rendered scores intact
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', fetchRealMatches);
    } else {
      fetchRealMatches();
    }

    // Refresh scores every 30 seconds
    setInterval(fetchRealMatches, 30000);
  })();
</script>
