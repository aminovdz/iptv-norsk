---
import { Tv, MessageCircle, Menu, X, ArrowRight, ShieldCheck } from 'lucide-astro';

const navLinks = [
  { name: 'Funksjoner', href: '/#features' },
  { name: 'Priser', href: '/#pricing' },
  { name: 'Enheter', href: '/#devices' },
  { name: 'Byer', href: '/#cities' },
  { name: 'Guider', href: '/guides' },
  { name: 'Verveprogram', href: '/referral' },
  { name: 'Kontakt', href: '/contact' },
];

const whatsappUrl = "https://wa.me/18036582620?text=Hei!%20Jeg%20ønsker%20mer%20informasjon%20om%20Norsk%20IPTV.";
---

<header class="sticky top-0 z-50 w-full backdrop-blur-xl bg-[#06060b]/85 border-b border-white/10 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-[#8b5cf6] rounded-lg p-1" aria-label="Norsk IPTV Hjemmeside">
        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#8b5cf6] to-[#06b6d4] p-[1.5px] shadow-lg shadow-[#8b5cf6]/20 transition-transform group-hover:scale-105">
          <div class="w-full h-full bg-[#0e0e17] rounded-[10px] flex items-center justify-center">
            <Tv class="w-5 h-5 text-[#06b6d4] transition-colors group-hover:text-white" />
          </div>
        </div>
        <div class="flex flex-col">
          <span class="text-xl font-extrabold tracking-tight text-white flex items-center gap-1.5">
            Norsk<span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">IPTV</span>
            <span class="text-[10px] font-semibold uppercase px-1.5 py-0.5 rounded bg-[#8b5cf6]/20 text-[#a78bfa] border border-[#8b5cf6]/30">4K</span>
          </span>
          <span class="text-[11px] text-gray-400 font-medium tracking-wide">Norges mest stabile TV</span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden lg:flex items-center gap-8" aria-label="Hovedmeny">
        {navLinks.map((link) => (
          <a
            href={link.href}
            class="text-sm font-medium text-gray-300 hover:text-white transition-colors relative py-1 hover:after:w-full after:content-[''] after:absolute after:bottom-0 after:left-0 after:w-0 after:h-[2px] after:bg-gradient-to-r after:from-[#8b5cf6] after:to-[#06b6d4] after:transition-all after:duration-300"
          >
            {link.name}
          </a>
        ))}
      </nav>

      <!-- Desktop Action CTAs -->
      <div class="hidden sm:flex items-center gap-3.5">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center gap-2 px-4 py-2 text-xs font-semibold rounded-xl bg-white/5 hover:bg-white/10 text-gray-200 hover:text-white border border-white/10 transition-all duration-200"
          aria-label="Kontakt kundeservice på WhatsApp"
        >
          <MessageCircle class="w-4 h-4 text-[#25D366]" />
          <span>WhatsApp Hjelp</span>
        </a>
        <a
          href="/#pricing"
          class="flex items-center gap-2 px-5 py-2.5 text-xs font-bold uppercase tracking-wider rounded-xl bg-gradient-to-r from-[#8b5cf6] to-[#7c3aed] hover:from-[#7c3aed] hover:to-[#6d28d9] text-white shadow-lg shadow-[#8b5cf6]/25 hover:shadow-[#8b5cf6]/40 transition-all duration-200 transform hover:-translate-y-0.5"
          aria-label="Se tilgjengelige IPTV priser og planer"
        >
          <span>Bestill Nå</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex lg:hidden items-center gap-2">
        <button
          type="button"
          id="mobile-menu-button"
          class="p-2.5 rounded-xl bg-white/5 border border-white/10 text-gray-300 hover:text-white focus:outline-none focus:ring-2 focus:ring-[#8b5cf6]"
          aria-label="Åpne eller lukk mobilmeny"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <Menu id="menu-icon-open" class="w-6 h-6 block" />
          <X id="menu-icon-close" class="w-6 h-6 hidden" />
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-[#0a0a12]/98 border-b border-white/10 px-4 pt-3 pb-6 transition-all duration-300">
    <div class="flex flex-col space-y-3">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="mobile-nav-item px-3 py-2.5 rounded-lg text-base font-medium text-gray-200 hover:text-white hover:bg-white/5 transition-colors"
        >
          {link.name}
        </a>
      ))}
      <div class="pt-4 border-t border-white/10 flex flex-col gap-3">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-2 w-full py-3 rounded-xl bg-white/5 border border-white/10 text-sm font-semibold text-white"
        >
          <MessageCircle class="w-4 h-4 text-[#25D366]" />
          <span>Kontakt på WhatsApp (24/7)</span>
        </a>
        <a
          href="/#pricing"
          class="flex items-center justify-center gap-2 w-full py-3.5 rounded-xl bg-gradient-to-r from-[#8b5cf6] to-[#7c3aed] text-sm font-bold text-white shadow-lg shadow-[#8b5cf6]/30"
        >
          <span>Se IPTV Priser & Planer</span>
          <ArrowRight class="w-4 h-4" />
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  const menuBtn = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const navItems = document.querySelectorAll('.mobile-nav-item');

  if (menuBtn && mobileMenu && iconOpen && iconClose) {
    menuBtn.addEventListener('click', () => {
      const isExpanded = menuBtn.getAttribute('aria-expanded') === 'true';
      menuBtn.setAttribute('aria-expanded', (!isExpanded).toString());
      mobileMenu.classList.toggle('hidden');
      iconOpen.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });

    navItems.forEach(item => {
      item.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
      });
    });
  }
</script>
