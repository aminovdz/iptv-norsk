---
import { ShoppingBag, Key, Download, PlayCircle, ArrowRight, Sparkles, CheckCircle2 } from 'lucide-astro';

const steps = [
  {
    stepNumber: "01",
    icon: ShoppingBag,
    title: "1. Velg Ditt Abonnement",
    description: "Velg ønsket periode (1, 3, 6 eller 12 måneder). Vi anbefaler vår 12-måneders pakke for best pris og uavbrutt tilgang.",
    highlight: "Ingen bindingstid"
  },
  {
    stepNumber: "02",
    icon: Key,
    title: "2. Motta Tilgangsdetaljer",
    description: "Rett etter bestilling mottar du dine personlige M3U-lenker og Xtream-koder på WhatsApp eller e-post på under 3 minutter.",
    highlight: "Umiddelbar levering"
  },
  {
    stepNumber: "03",
    icon: Download,
    title: "3. Last Ned Din IPTV App",
    description: "Bruk din favorittapp som TiviMate, IBO Player eller IPTV Smarters på Smart TV, Firestick, Apple TV eller mobil.",
    highlight: "Enkel oppsettsguide"
  },
  {
    stepNumber: "04",
    icon: PlayCircle,
    title: "4. Nyt 4K Strømming",
    description: "Logg inn med dine koder og opplev direktesendt sport, filmer og underholdning i 4K UHD med lynrask Anti-Freeze™ kvalitet.",
    highlight: "Klar på sekunder"
  }
];
---

<section id="process" class="py-20 md:py-28 relative overflow-hidden bg-white/[0.01]" aria-labelledby="process-heading">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#06b6d4]" />
        <span>Enkel Kom-i-Gang Guide</span>
      </div>
      <h2 id="process-heading" class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
        Slik Kommer Du i Gang med <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">Norsk IPTV</span>
      </h2>
      <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
        Det tar under tre minutter fra bestilling til du kan lene deg tilbake og nyte førsteklasses <strong>IPTV Norge</strong> underholdning.
      </p>
    </div>

    <!-- Steps Grid (4 Columns with Connecting Flow) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 relative">
      {steps.map((item, index) => {
        const IconComponent = item.icon;
        return (
          <div class="relative rounded-3xl bg-[#0e0e17] border border-white/10 hover:border-[#8b5cf6]/40 p-7 transition-all duration-300 transform hover:-translate-y-1 shadow-lg group flex flex-col justify-between">
            
            <div>
              <!-- Top Row: Step Number & Icon -->
              <div class="flex items-center justify-between mb-6">
                <span class="text-3xl font-black text-white/20 group-hover:text-[#8b5cf6]/40 font-mono transition-colors">
                  {item.stepNumber}
                </span>
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-[#8b5cf6]/20 to-[#06b6d4]/20 border border-[#8b5cf6]/30 flex items-center justify-center text-[#06b6d4] group-hover:text-white group-hover:scale-105 transition-all">
                  <IconComponent class="w-6 h-6" />
                </div>
              </div>

              <!-- Step Title -->
              <h3 class="text-lg font-bold text-white mb-3 group-hover:text-[#a78bfa] transition-colors">
                {item.title}
              </h3>

              <!-- Step Description -->
              <p class="text-sm text-gray-400 leading-relaxed mb-6">
                {item.description}
              </p>
            </div>

            <!-- Highlight Tag -->
            <div class="pt-4 border-t border-white/5 flex items-center gap-2 text-xs font-semibold text-[#06b6d4]">
              <CheckCircle2 class="w-3.5 h-3.5" />
              <span>{item.highlight}</span>
            </div>

          </div>
        );
      })}
    </div>

    <!-- Process Help Callout -->
    <div class="mt-12 text-center">
      <div class="inline-flex flex-col sm:flex-row items-center gap-3 p-4 rounded-2xl bg-[#0e0e17] border border-white/10 text-xs sm:text-sm text-gray-300">
        <span>Trenger du personlig hjelp under oppsettet?</span>
        <a
          href="https://wa.me/213550592200?text=Hei!%20Jeg%20trenger%20hjelp%20med%20å%20sette%20opp%20Norsk%20IPTV."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 font-bold text-[#8b5cf6] hover:text-[#a78bfa] transition-colors"
        >
          <span>Få gratis veiledning på WhatsApp</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>
    </div>

  </div>
</section>
