---
import { ShieldCheck, Zap, Star, Tv, MessageCircle, Play, CheckCircle2, Award, Sparkles } from 'lucide-astro';

interface Props {
  h1Text?: string;
  subtitle?: string;
  badge?: string;
  city?: string;
  ctaText?: string;
  ctaLink?: string;
}

const {
  h1Text = "IPTV Norge — Norges Mest Stabile IPTV med 4K & Anti-Buffer",
  subtitle = "Opplev en førsteklasses TV-opplevelse med Norsk IPTV. Få lynrask tilgang til direktesendt sport, underholdning og direktesendinger i krystallklar 4K Ultra HD med overlegen stabilitet på alle enheter.",
  badge = "🇳🇴 Norges #1 IPTV Leverandør 2026",
  city,
  ctaText = "Se Priser & Planer",
  ctaLink = "#pricing",
} = Astro.props;

const whatsappUrl = "https://wa.me/213550592200?text=Hei!%20Jeg%20ønsker%20en%20gratis%20test%20av%20Norsk%20IPTV.";

const trustBadges = [
  "99.9% Dokumentert Oppetid",
  "Anti-Buffer™ 9.0 Teknologi",
  "Ingen Bindingstid",
  "Aktivering på under 3 min",
];
---

<section class="relative pt-12 pb-12 md:pt-20 md:pb-16 overflow-hidden" aria-labelledby="hero-heading">
  
  <!-- Subtle Background Glow Orbs -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[350px] bg-gradient-to-tr from-[#8b5cf6]/20 to-[#06b6d4]/15 blur-[120px] rounded-full pointer-events-none -z-10"></div>
  <div class="absolute top-10 right-10 w-72 h-72 bg-[#8b5cf6]/10 blur-[90px] rounded-full pointer-events-none -z-10"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Hero Left Column: Copy & CTAs -->
      <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left">
        
        <!-- Live Quality Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-6 shadow-sm">
          <span class="w-2 h-2 rounded-full bg-[#10b981] animate-pulse"></span>
          <span>{city ? `Eksklusiv IPTV Tjeneste for ${city}` : badge}</span>
        </div>

        <!-- Semantic Main H1 Tag (Strictly One per page) -->
        <h1 id="hero-heading" class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-[1.15] mb-6">
          {city ? (
            <span>
              IPTV {city} — <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] via-[#a78bfa] to-[#06b6d4]">Beste Norske IPTV</span> i 4K & FHD
            </span>
          ) : (
            <span>
              IPTV Norge — <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] via-[#a78bfa] to-[#06b6d4]">Norges Mest Stabile</span> IPTV Tjeneste
            </span>
          )}
        </h1>

        <!-- Opening Paragraph (75-100 words with primary & secondary keywords) -->
        <p class="text-base sm:text-lg text-gray-300 max-w-2xl leading-relaxed mb-8">
          {subtitle} Enten du ser på direktesendt vintersport, fotball eller filmer, gir vårt <strong>IPTV abonnement i Norge</strong> deg førsteklasses flyt uten forsinkelser. Test markedets ledende <strong>norske IPTV</strong> løsning tilpasset nordiske bredbåndsnettverk.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center gap-4 w-full sm:w-auto mb-10">
          <a
            href={ctaLink}
            class="w-full sm:w-auto flex items-center justify-center gap-3 px-8 py-4 text-base font-bold rounded-2xl bg-gradient-to-r from-[#8b5cf6] to-[#7c3aed] hover:from-[#7c3aed] hover:to-[#6d28d9] text-white shadow-xl shadow-[#8b5cf6]/30 hover:shadow-[#8b5cf6]/50 transition-all duration-300 transform hover:-translate-y-0.5"
            aria-label="Gå til prisoversikt for IPTV abonnement"
          >
            <span>{ctaText}</span>
            <Zap class="w-5 h-5 fill-white text-white" />
          </a>
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full sm:w-auto flex items-center justify-center gap-3 px-7 py-4 text-base font-semibold rounded-2xl bg-[#0e0e17] hover:bg-[#141422] text-gray-200 hover:text-white border border-white/15 hover:border-[#25D366]/40 transition-all duration-300"
            aria-label="Få gratis IPTV test via WhatsApp kundeservice"
          >
            <MessageCircle class="w-5 h-5 text-[#25D366]" />
            <span>Få Gratis Test (WhatsApp)</span>
          </a>
        </div>

        <!-- Trust Features List -->
        <div class="grid grid-cols-2 sm:grid-cols-2 gap-3.5 w-full pt-4 border-t border-white/10 text-left">
          {trustBadges.map((badgeText) => (
            <div class="flex items-center gap-2 text-xs sm:text-sm text-gray-300 font-medium">
              <CheckCircle2 class="w-4 h-4 text-[#06b6d4] shrink-0" />
              <span>{badgeText}</span>
            </div>
          ))}
        </div>

      </div>

      <!-- Hero Right Column: Sleek Glassmorphic Streaming Player Mockup -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Outer Neon Border Frame -->
          <div class="rounded-3xl p-1 bg-gradient-to-b from-[#8b5cf6]/40 via-white/10 to-[#06b6d4]/30 shadow-2xl shadow-[#8b5cf6]/20">
            <div class="rounded-[22px] bg-[#0c0c16] overflow-hidden p-5 sm:p-6 border border-white/5">
              
              <!-- Player Top Status Bar -->
              <div class="flex items-center justify-between pb-4 border-b border-white/10 mb-5">
                <div class="flex items-center gap-2">
                  <span class="w-3 h-3 rounded-full bg-red-500/80 inline-block"></span>
                  <span class="w-3 h-3 rounded-full bg-yellow-500/80 inline-block"></span>
                  <span class="w-3 h-3 rounded-full bg-green-500/80 inline-block"></span>
                  <span class="text-xs text-gray-400 font-mono ml-2">Norsk IPTV v4.2 • 4K UHD</span>
                </div>
                <div class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-500/20 text-[10px] font-semibold text-emerald-400 border border-emerald-500/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
                  LIVE STREAM
                </div>
              </div>

              <!-- Stream Visual Display Mockup -->
              <div class="relative rounded-2xl bg-gradient-to-br from-[#121222] to-[#0a0a14] border border-white/10 p-6 flex flex-col items-center justify-center min-h-[220px] text-center overflow-hidden group">
                <div class="absolute inset-0 bg-radial from-[#8b5cf6]/15 via-transparent to-transparent opacity-60"></div>
                
                <div class="w-14 h-14 rounded-2xl bg-gradient-to-tr from-[#8b5cf6] to-[#06b6d4] p-[2px] mb-3 shadow-lg shadow-[#8b5cf6]/40 flex items-center justify-center transform group-hover:scale-110 transition-transform">
                  <div class="w-full h-full bg-[#0e0e17] rounded-[14px] flex items-center justify-center">
                    <Play class="w-6 h-6 text-white fill-white ml-0.5" />
                  </div>
                </div>

                <div class="text-sm font-bold text-white mb-1">Ultra HD 4K Direktesending</div>
                <div class="text-xs text-gray-400">60 FPS • 0% Pakketap • Dolby Audio 5.1</div>
                
                <!-- Micro Progress Live Bar -->
                <div class="w-full mt-5 bg-white/10 rounded-full h-1.5 overflow-hidden">
                  <div class="bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4] h-full w-4/5 rounded-full"></div>
                </div>
              </div>

              <!-- EPG Mini Guide Bar -->
              <div class="mt-5 space-y-2.5">
                <div class="text-xs font-semibold text-gray-400 uppercase tracking-wider">Direkte Programguide (EPG)</div>
                <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/5 border border-white/5 text-xs">
                  <div class="flex items-center gap-2.5">
                    <span class="px-2 py-0.5 rounded bg-[#8b5cf6]/30 text-[#a78bfa] font-bold text-[10px]">SPORT 1</span>
                    <span class="text-gray-200 font-medium">Hovedkampen Direkte (4K)</span>
                  </div>
                  <span class="text-gray-400 text-[11px]">NÅ</span>
                </div>
                <div class="flex items-center justify-between p-2.5 rounded-xl bg-white/[0.02] border border-white/5 text-xs">
                  <div class="flex items-center gap-2.5">
                    <span class="px-2 py-0.5 rounded bg-cyan-500/20 text-cyan-300 font-bold text-[10px]">PREMIUM</span>
                    <span class="text-gray-300 font-medium">Nordisk Vintermagasin</span>
                  </div>
                  <span class="text-gray-500 text-[11px]">20:30</span>
                </div>
              </div>

              <!-- Customer Satisfaction Snippet -->
              <div class="mt-5 pt-4 border-t border-white/10 flex items-center justify-between">
                <div class="flex items-center gap-1 text-[#f59e0b]">
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                  <Star class="w-4 h-4 fill-current" />
                  <span class="text-xs font-bold text-white ml-1.5">4.9 / 5</span>
                </div>
                <span class="text-xs text-gray-400">9 800+ norske brukere</span>
              </div>

            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
