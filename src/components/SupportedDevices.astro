---
import { Tv, Smartphone, Laptop, Cast, Cpu, Check, Sparkles, Box } from 'lucide-astro';

const deviceCategories = [
  {
    icon: Tv,
    title: "Smart TV & Android TV",
    description: "Kompatibel med Samsung (Tizen), LG (webOS), Sony, Philips, TCL og alle TV-er med Google TV eller Android TV.",
    popularApps: ["TiviMate", "IBO Player", "Smart IPTV", "Nanomid"]
  },
  {
    icon: Cast,
    title: "Streaming-enheter & Dongler",
    description: "Optimerte innstillinger for Amazon Fire TV Stick 4K / Max, Apple TV 4K, Google Chromecast og Nvidia Shield.",
    popularApps: ["TiviMate Premium", "iPlayTV", "Smarters Pro"]
  },
  {
    icon: Smartphone,
    title: "Smarttelefoner & Nettbrett",
    description: "Ta med deg underholdningen på farten med full støtte for Apple iOS (iPhone/iPad) og alle Android-enheter.",
    popularApps: ["GSE Smart IPTV", "IPTV Smarters", "Smarters Player Lite"]
  },
  {
    icon: Laptop,
    title: "PC, Mac & Nettleser",
    description: "Strøm direkte via din datamaskin med VLC Media Player, IPTV Smarters Desktop eller vår sikre web-avspiller.",
    popularApps: ["VLC Media Player", "IPTV Smarters Pro", "WebTV"]
  },
  {
    icon: Cpu,
    title: "Dedikerte IPTV-Bokser",
    description: "Full portal- og MAC-adresse støtte for MAG (250, 254, 322, 524 osv.), Formuler Z-serien og BuzzTV.",
    popularApps: ["MAG Portal (Stalker)", "MyTVOnline 2/3"]
  }
];

const supportedProtocols = [
  "M3U & M3U8 Spillelister",
  "Xtream Codes API",
  "Stalker Portal (MAC)",
  "EPG XMLTV Guide",
  "HLS & MPEG-TS Strømmer"
];
---

<section id="devices" class="py-20 md:py-28 relative overflow-hidden" aria-labelledby="devices-heading">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#06b6d4]" />
        <span>100% Multi-Enhet Kompatibilitet</span>
      </div>
      <h2 id="devices-heading" class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
        Støttede Enheter & <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">Beste IPTV Apper</span>
      </h2>
      <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
        Uansett hvilken enhet du foretrekker i stua eller på farten, fungerer <strong>Norsk IPTV</strong> sømløst med de mest populære og pålitelige spillerne på markedet.
      </p>
    </div>

    <!-- Device Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
      {deviceCategories.map((device) => {
        const IconComponent = device.icon;
        return (
          <div class="rounded-3xl bg-[#0e0e17] border border-white/10 hover:border-[#8b5cf6]/40 p-7 transition-all duration-300 hover:shadow-xl group flex flex-col justify-between">
            <div>
              <!-- Icon & Title -->
              <div class="flex items-center gap-3.5 mb-4">
                <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-[#8b5cf6]/20 to-[#06b6d4]/20 border border-[#8b5cf6]/30 flex items-center justify-center text-[#06b6d4] group-hover:text-white transition-colors">
                  <IconComponent class="w-6 h-6" />
                </div>
                <h3 class="text-lg font-bold text-white group-hover:text-[#a78bfa] transition-colors">
                  {device.title}
                </h3>
              </div>

              <!-- Description -->
              <p class="text-sm text-gray-400 leading-relaxed mb-6">
                {device.description}
              </p>
            </div>

            <!-- Recommended Apps Pill List -->
            <div class="pt-4 border-t border-white/5">
              <span class="text-[11px] font-semibold uppercase tracking-wider text-gray-500 block mb-2">Anbefalte Apper:</span>
              <div class="flex flex-wrap gap-1.5">
                {device.popularApps.map((app) => (
                  <span class="text-xs px-2.5 py-1 rounded-md bg-white/5 border border-white/10 text-gray-300 font-medium">
                    {app}
                  </span>
                ))}
              </div>
            </div>

          </div>
        );
      })}
    </div>

    <!-- Supported Protocols Bar -->
    <div class="rounded-2xl bg-[#0a0a14] border border-white/10 p-6 flex flex-col md:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-3 text-sm font-bold text-white">
        <Box class="w-5 h-5 text-[#8b5cf6]" />
        <span>Støttede Strømmeprotokoller:</span>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-3 text-xs text-gray-300">
        {supportedProtocols.map((protocol) => (
          <div class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/5 border border-white/10">
            <Check class="w-3.5 h-3.5 text-[#06b6d4]" />
            <span>{protocol}</span>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>
