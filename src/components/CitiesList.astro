---
import { MapPin, Navigation, Sparkles, ArrowRight, ShieldCheck } from 'lucide-astro';

interface CityItem {
  name: string;
  slug: string;
  region: string;
  latency: string;
  highlight: string;
}

const targetCities: CityItem[] = [
  {
    name: 'Oslo',
    slug: 'oslo',
    region: 'Østlandet',
    latency: '< 8ms CDN',
    highlight: 'Optimalisert for Telenor, Telia & Viken fiber'
  },
  {
    name: 'Bergen',
    slug: 'bergen',
    region: 'Vestland',
    latency: '< 11ms CDN',
    highlight: 'Dedikert ruting for Vestlandets bredbånd'
  },
  {
    name: 'Trondheim',
    slug: 'trondheim',
    region: 'Trøndelag',
    latency: '< 13ms CDN',
    highlight: 'Lynrask peering for Midt-Norge'
  },
  {
    name: 'Stavanger',
    slug: 'stavanger',
    region: 'Rogaland',
    latency: '< 10ms CDN',
    highlight: 'Bufferfri sport og Altibox-tilpasning'
  },
  {
    name: 'Kristiansand',
    slug: 'kristiansand',
    region: 'Agder',
    latency: '< 9ms CDN',
    highlight: 'Direkte forbindelse for Sørlandet'
  },
  {
    name: 'Drammen',
    slug: 'drammen',
    region: 'Buskerud',
    latency: '< 8ms CDN',
    highlight: 'Lav latens og topp kvalitet'
  },
  {
    name: 'Tromsø',
    slug: 'tromso',
    region: 'Nord-Norge',
    latency: '< 18ms CDN',
    highlight: 'Stabil arktisk strømmetilkobling'
  }
];
---

<section id="cities" class="py-20 md:py-28 relative overflow-hidden bg-white/[0.01]" aria-labelledby="cities-heading">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16 md:mb-20">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-4">
        <Sparkles class="w-3.5 h-3.5 text-[#06b6d4]" />
        <span>Lokal Norsk Tilstedeværelse</span>
      </div>
      <h2 id="cities-heading" class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
        IPTV Tilpasset <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">Norske Byer & Regioner</span>
      </h2>
      <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
        Vi distribuerer strømmetrafikken via lokale servernoder i og rundt Norges største byer. Dette sikrer minimal forsinkelse og uavbrutt 4K-oppløsning på lokale nettverk.
      </p>
    </div>

    <!-- Cities Grid (7 cities) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5 mb-12">
      {targetCities.map((city) => (
        <a
          href={`/locations/${city.slug}`}
          class="group rounded-2xl bg-[#0e0e17] border border-white/10 hover:border-[#8b5cf6]/50 p-6 transition-all duration-300 transform hover:-translate-y-1 hover:shadow-xl hover:shadow-[#8b5cf6]/10 flex flex-col justify-between"
          aria-label={`Les mer om IPTV i ${city.name}`}
        >
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-[#8b5cf6]/10 border border-[#8b5cf6]/25 flex items-center justify-center text-[#8b5cf6] group-hover:bg-[#8b5cf6] group-hover:text-white transition-colors">
                  <MapPin class="w-4 h-4" />
                </div>
                <div>
                  <h3 class="text-base font-bold text-white group-hover:text-[#06b6d4] transition-colors">
                    IPTV {city.name}
                  </h3>
                  <span class="text-[11px] text-gray-500">{city.region}</span>
                </div>
              </div>
              <span class="text-[10px] font-mono font-semibold px-2 py-0.5 rounded bg-white/5 border border-white/10 text-emerald-400">
                {city.latency}
              </span>
            </div>

            <p class="text-xs text-gray-400 leading-relaxed mb-4">
              {city.highlight}
            </p>
          </div>

          <div class="pt-3 border-t border-white/5 flex items-center justify-between text-xs font-semibold text-[#8b5cf6] group-hover:text-[#a78bfa] transition-colors">
            <span>Se lokal serverstatus</span>
            <ArrowRight class="w-3.5 h-3.5 transform group-hover:translate-x-1 transition-transform" />
          </div>
        </a>
      ))}
    </div>

    <!-- Geo Trust Footer -->
    <div class="text-center">
      <p class="text-xs text-gray-400">
        Bor du utenfor disse byene? Vårt nettverk dekker <strong>100% av Norge</strong> fra Lindesnes til Nordkapp med lynrask fiber- og 5G-ytelse.
      </p>
    </div>

  </div>
</section>
