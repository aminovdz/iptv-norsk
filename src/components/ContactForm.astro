---
import { Mail, MessageCircle, Send, Phone, Clock, ShieldCheck, CheckCircle2, ArrowRight, ExternalLink } from 'lucide-astro';

const whatsappUrl = "https://wa.me/18036582620";
const whatsappChannelUrl = "https://whatsapp.com/channel/0029VayVaLpD8SE3bf8wMY3v";
const telegramUrl = "https://t.me/castvera_com";
---

<section id="contact" class="py-20 md:py-28 relative overflow-hidden" aria-labelledby="contact-heading">
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 text-xs font-semibold text-[#a78bfa] mb-4">
        <Clock class="w-3.5 h-3.5 text-[#06b6d4]" />
        <span>24/7 Døgnåpen Norsk Support</span>
      </div>
      <h2 id="contact-heading" class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-white tracking-tight mb-6">
        Ta Kontakt med <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#8b5cf6] to-[#06b6d4]">Norsk IPTV Kundeservice</span>
      </h2>
      <p class="text-base sm:text-lg text-gray-300 leading-relaxed">
        Har du spørsmål om abonnement, oppsett på Smart TV eller feilsøking? Vårt dedikerte team hjelper deg lynraskt via WhatsApp, Telegram eller e-post.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      
      <!-- Contact Info Cards Column (Left - 5 cols) -->
      <div class="lg:col-span-5 space-y-4">
        
        <!-- WhatsApp Direct Card -->
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-start gap-4 p-5 rounded-2xl bg-[#0e0e17] border border-white/10 hover:border-[#25D366]/50 transition-all group"
        >
          <div class="w-12 h-12 rounded-xl bg-[#25D366]/15 border border-[#25D366]/30 flex items-center justify-center text-[#25D366] shrink-0 group-hover:scale-105 transition-transform">
            <MessageCircle class="w-6 h-6 fill-current" />
          </div>
          <div class="flex-1">
            <div class="flex items-center justify-between">
              <span class="text-sm font-bold text-white group-hover:text-[#25D366] transition-colors">WhatsApp Live Support</span>
              <span class="text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-500/20 text-emerald-400">Raskest</span>
            </div>
            <p class="text-xs text-gray-400 mt-1">Direkte hjelp på norsk/engelsk 24 timer i døgnet.</p>
            <span class="text-xs font-mono font-bold text-gray-300 mt-2 block">+1 (803) 658-2620</span>
          </div>
        </a>

        <!-- Telegram Channel Card -->
        <a
          href={telegramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-start gap-4 p-5 rounded-2xl bg-[#0e0e17] border border-white/10 hover:border-[#229ED9]/50 transition-all group"
        >
          <div class="w-12 h-12 rounded-xl bg-[#229ED9]/15 border border-[#229ED9]/30 flex items-center justify-center text-[#229ED9] shrink-0 group-hover:scale-105 transition-transform">
            <Send class="w-6 h-6" />
          </div>
          <div class="flex-1">
            <span class="text-sm font-bold text-white group-hover:text-[#229ED9] transition-colors">Offisiell Telegram Kanal</span>
            <p class="text-xs text-gray-400 mt-1">Servervarsler, kampoppsett og medlemsfordeler.</p>
            <span class="text-xs font-mono text-[#229ED9] mt-2 block">@castvera_com</span>
          </div>
        </a>

        <!-- WhatsApp Community Channel Card -->
        <a
          href={whatsappChannelUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-start gap-4 p-5 rounded-2xl bg-[#0e0e17] border border-white/10 hover:border-[#25D366]/40 transition-all group"
        >
          <div class="w-12 h-12 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-[#25D366] shrink-0">
            <ExternalLink class="w-6 h-6" />
          </div>
          <div class="flex-1">
            <span class="text-sm font-bold text-white group-hover:text-[#25D366] transition-colors">WhatsApp Nyhetskanal</span>
            <p class="text-xs text-gray-400 mt-1">Motta eksklusive kampanjer og veiledninger.</p>
            <span class="text-xs text-gray-400 mt-2 block">Bli med i Norsk IPTV Community</span>
          </div>
        </a>

        <!-- Emails Box -->
        <div class="p-5 rounded-2xl bg-[#0e0e17] border border-white/10 space-y-3">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-[#8b5cf6]/10 border border-[#8b5cf6]/30 flex items-center justify-center text-[#8b5cf6] shrink-0">
              <Mail class="w-5 h-5" />
            </div>
            <div>
              <span class="text-xs text-gray-400 block">Hovedsupport:</span>
              <a href="mailto:contact@norsk-iptv.net" class="text-xs sm:text-sm font-bold text-white hover:text-[#8b5cf6] transition-colors">contact@norsk-iptv.net</a>
            </div>
          </div>

          <div class="flex items-center gap-3 pt-3 border-t border-white/5">
            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-[#06b6d4] shrink-0">
              <Mail class="w-5 h-5" />
            </div>
            <div>
              <span class="text-xs text-gray-400 block">Teknisk Beredskap:</span>
              <a href="mailto:support@castvera.com" class="text-xs sm:text-sm font-bold text-white hover:text-[#06b6d4] transition-colors">support@castvera.com</a>
            </div>
          </div>
        </div>

      </div>

      <!-- Contact Form Column (Right - 7 cols) -->
      <div class="lg:col-span-7">
        <div class="rounded-3xl bg-[#0e0e17] border border-white/10 p-7 sm:p-9 shadow-xl relative">
          
          <h3 class="text-xl font-bold text-white mb-2">Send Oss En Melding</h3>
          <p class="text-xs sm:text-sm text-gray-400 mb-6">Fyll ut skjemaet nedenfor, så svarer vi deg innen 30 minutter.</p>

          <form id="contact-form" class="space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Full Name -->
              <div>
                <label for="name" class="block text-xs font-semibold text-gray-300 mb-1.5">Ditt Navn *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="f.eks. Ole Nordmann"
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-[#8b5cf6] focus:ring-2 focus:ring-[#8b5cf6]/30 text-white placeholder-gray-500 text-sm transition-all focus:outline-none"
                />
              </div>

              <!-- Email -->
              <div>
                <label for="email" class="block text-xs font-semibold text-gray-300 mb-1.5">Din E-postadresse *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="ole@eksempel.no"
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-[#8b5cf6] focus:ring-2 focus:ring-[#8b5cf6]/30 text-white placeholder-gray-500 text-sm transition-all focus:outline-none"
                />
              </div>
            </div>

            <!-- Subject & Device -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="device" class="block text-xs font-semibold text-gray-300 mb-1.5">Hovedenhet</label>
                <select
                  id="device"
                  name="device"
                  class="w-full px-4 py-3 rounded-xl bg-[#141422] border border-white/10 focus:border-[#8b5cf6] focus:ring-2 focus:ring-[#8b5cf6]/30 text-white text-sm transition-all focus:outline-none"
                >
                  <option value="Smart TV (Samsung/LG/Sony)">Smart TV (Samsung, LG, Sony)</option>
                  <option value="Firestick 4K / Android TV">Amazon Firestick 4K / Android TV</option>
                  <option value="Apple TV 4K">Apple TV 4K</option>
                  <option value="Mobil (iOS / Android)">Mobil (iPhone / Android)</option>
                  <option value="PC / Mac">PC / Mac</option>
                  <option value="Annet / Flere enheter">Annet / Flere enheter</option>
                </select>
              </div>

              <div>
                <label for="subject" class="block text-xs font-semibold text-gray-300 mb-1.5">Emne</label>
                <input
                  type="text"
                  id="subject"
                  name="subject"
                  placeholder="f.eks. Bestilling / Teknisk spørsmål"
                  class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-[#8b5cf6] focus:ring-2 focus:ring-[#8b5cf6]/30 text-white placeholder-gray-500 text-sm transition-all focus:outline-none"
                />
              </div>
            </div>

            <!-- Message -->
            <div>
              <label for="message" class="block text-xs font-semibold text-gray-300 mb-1.5">Din Melding *</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Skriv inn ditt spørsmål her..."
                class="w-full px-4 py-3 rounded-xl bg-white/5 border border-white/10 focus:border-[#8b5cf6] focus:ring-2 focus:ring-[#8b5cf6]/30 text-white placeholder-gray-500 text-sm transition-all focus:outline-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="contact-submit-btn"
              class="w-full flex items-center justify-center gap-2 py-4 px-6 rounded-xl bg-gradient-to-r from-[#8b5cf6] to-[#7c3aed] hover:from-[#7c3aed] hover:to-[#6d28d9] text-white font-bold text-sm uppercase tracking-wider shadow-lg shadow-[#8b5cf6]/30 transition-all transform hover:-translate-y-0.5"
            >
              <span>Send Melding</span>
              <ArrowRight class="w-4 h-4" />
            </button>

            <!-- Success Alert Notification -->
            <div
              id="form-success-msg"
              class="hidden p-4 rounded-xl bg-emerald-500/20 border border-emerald-500/30 text-emerald-300 text-xs sm:text-sm flex items-center gap-3"
            >
              <CheckCircle2 class="w-5 h-5 text-emerald-400 shrink-0" />
              <span>Tusen takk! Din henvendelse er mottatt. Vi svarer deg snarest på e-post eller WhatsApp.</span>
            </div>

          </form>

        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement;
  const successMsg = document.getElementById('form-success-msg');
  const submitBtn = document.getElementById('contact-submit-btn');

  if (form && successMsg && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.add('opacity-70');
      
      setTimeout(() => {
        form.reset();
        successMsg.classList.remove('hidden');
        submitBtn.removeAttribute('disabled');
        submitBtn.classList.remove('opacity-70');
      }, 600);
    });
  }
</script>
