---
import { CheckCircle2, Tv, X } from 'lucide-astro';
---

<!-- Social Proof Live Notification Toast (Bottom-Left) -->
<aside
  id="social-popup"
  class="fixed bottom-6 left-6 z-40 max-w-sm rounded-2xl bg-[#0e0e17]/95 border border-[#8b5cf6]/40 p-4 shadow-2xl shadow-[#8b5cf6]/20 backdrop-blur-xl transform -translate-x-full opacity-0 transition-all duration-500 pointer-events-none"
  aria-live="polite"
  aria-atomic="true"
>
  <div class="flex items-start gap-3.5">
    
    <!-- Pulse Streaming Icon -->
    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-[#8b5cf6] to-[#06b6d4] p-[1.5px] shrink-0 mt-0.5">
      <div class="w-full h-full bg-[#0e0e17] rounded-[9px] flex items-center justify-center">
        <Tv class="w-5 h-5 text-[#06b6d4]" />
      </div>
    </div>

    <!-- Message Content -->
    <div class="flex-1 pr-4">
      <div class="flex items-center gap-1 text-[10px] font-bold text-emerald-400 uppercase tracking-wider mb-0.5">
        <CheckCircle2 class="w-3 h-3" />
        <span id="social-status">Nettopp aktivert</span>
      </div>
      <div id="social-name" class="text-xs font-bold text-white leading-tight">
        Lars E. fra Oslo
      </div>
      <p id="social-action" class="text-[11px] text-gray-300 mt-0.5">
        Kjøpte 12 Måneder VIP (4K Ultra HD)
      </p>
      <span id="social-time" class="text-[10px] text-gray-500 mt-1 block">
        For 2 minutter siden
      </span>
    </div>

    <!-- Close Button -->
    <button
      type="button"
      id="social-popup-close"
      class="text-gray-400 hover:text-white p-1 transition-colors"
      aria-label="Lukk varsling"
    >
      <X class="w-4 h-4" />
    </button>

  </div>
</aside>

<script>
  const socialEvents = [
    { name: "Lars E. fra Oslo", action: "Kjøpte 12 Måneder VIP (4K Ultra HD)", time: "For 2 minutter siden" },
    { name: "Ingrid M. fra Bergen", action: "Fornyet 12 Måneders abonnement", time: "For 7 minutter siden" },
    { name: "Magnus T. fra Trondheim", action: "Aktiverte 6 Måneder Pro pakke", time: "For 14 minutter siden" },
    { name: "Espen K. fra Stavanger", action: "Kjøpte 12 Måneder VIP med EPG", time: "For 22 minutter siden" },
    { name: "Silje H. fra Kristiansand", action: "Startet 3 Måneder Pluss test", time: "For 35 minutter siden" },
    { name: "Jonas B. fra Tromsø", action: "Kjøpte 12 Måneder VIP (Anti-Freeze™)", time: "For 48 minutter siden" },
  ];

  let currentIndex = 0;
  let popupElement = document.getElementById('social-popup');
  let closeBtn = document.getElementById('social-popup-close');
  let isDismissed = false;

  function showSocialNotification() {
    if (!popupElement || isDismissed) return;

    const data = socialEvents[currentIndex];
    const nameEl = document.getElementById('social-name');
    const actionEl = document.getElementById('social-action');
    const timeEl = document.getElementById('social-time');

    if (nameEl && actionEl && timeEl) {
      nameEl.textContent = data.name;
      actionEl.textContent = data.action;
      timeEl.textContent = data.time;
    }

    popupElement.classList.remove('-translate-x-full', 'opacity-0', 'pointer-events-none');
    popupElement.classList.add('translate-x-0', 'opacity-100', 'pointer-events-auto');

    // Auto hide after 5.5 seconds
    setTimeout(() => {
      if (!isDismissed && popupElement) {
        popupElement.classList.add('-translate-x-full', 'opacity-0', 'pointer-events-none');
        popupElement.classList.remove('translate-x-0', 'opacity-100', 'pointer-events-auto');
      }
    }, 5500);

    currentIndex = (currentIndex + 1) % socialEvents.length;
  }

  // Close handler
  closeBtn?.addEventListener('click', () => {
    isDismissed = true;
    if (popupElement) {
      popupElement.classList.add('-translate-x-full', 'opacity-0', 'pointer-events-none');
      popupElement.classList.remove('translate-x-0', 'opacity-100', 'pointer-events-auto');
    }
  });

  // Start rotation after 7 seconds, then every 22 seconds
  setTimeout(() => {
    showSocialNotification();
    setInterval(showSocialNotification, 22000);
  }, 7000);
</script>
